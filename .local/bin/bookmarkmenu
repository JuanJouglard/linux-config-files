#!/bin/zsh

BOOKMARKS_DIR="$HOME/.local/share/bookmarks"
CURRENT_FILE="$BOOKMARKS_DIR/main.txt"
PROMPT="Select"

while true; do
  # Show options
  CHOICE=$(cut -d'|' -f1 "$CURRENT_FILE" | wofi -i -l 100 --prompt "$PROMPT")

  # Exit if nothing selected
  [[ -z "$CHOICE" ]] && exit 1

  # Get second field (the value)
  VALUE=$(grep "^$CHOICE" "$CURRENT_FILE" | cut -d'|' -f2- | awk '{$1=$1};1')

  # Check if VALUE is RECENT
  if [[ "$VALUE" == "RECENT" ]]; then
    # Create temporary file with recent Firefox history
    TEMP_FILE=$(mktemp)
    sqlite3 ~/.mozilla/firefox/*.default-release/places.sqlite "SELECT COALESCE(title, url), url FROM moz_places WHERE url NOT LIKE 'moz-%' ORDER BY last_visit_date DESC LIMIT 100;" | while IFS='|' read -r title url; do
      # Clean up title and truncate if too long
      clean_title=$(echo "$title" | sed 's/[|]/ /g' | cut -c1-60)
      if [[ ${#title} -gt 60 ]]; then
        clean_title="${clean_title}..."
      fi
      echo "$clean_title|$url" >> "$TEMP_FILE"
    done
    CURRENT_FILE="$TEMP_FILE"
    PROMPT="$CHOICE"
    continue
  fi

  # Check if VALUE is a URL
  if [[ "$VALUE" =~ ^https?:// ]]; then
    firefox "$VALUE"
    exit 0
  fi

  # Otherwise, assume it's a file and go deeper
  NEXT_FILE="$BOOKMARKS_DIR/$VALUE"
  if [[ -f "$NEXT_FILE" ]]; then
    CURRENT_FILE="$NEXT_FILE"
    PROMPT="$CHOICE"
  else
    echo "Invalid selection or file not found: $NEXT_FILE"
    exit 1
  fi
done

