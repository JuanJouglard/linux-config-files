#!/bin/zsh
BOOKMARKS="$HOME/.local/share/bookmarks/main.txt"

CHOICE=$(cat "$BOOKMARKS" | cut -d'|' -f1 | wofi  -i -l 100)

[[ -z "$CHOICE" ]] && exit 1

SUB_FILE=$(grep "^$CHOICE" "$BOOKMARKS" | cut -d'|' -f2 | awk '{$1=$1};1')

COMPLETE_PATH="$HOME/.local/share/bookmarks/$SUB_FILE"

CHOICE=$(cat "$COMPLETE_PATH" | cut -d'|' -f1 | wofi  -i -l 100 --prompt $CHOICE)

URL=$(grep "^$CHOICE" "$COMPLETE_PATH" | cut -d'|' -f2)

firefox "$URL"
